# ============================================================================
# NEXARA — Environment Template (NO SECRETS)
# ----------------------------------------------------------------------------
# Copy this file to a protected, untracked location (e.g. `.env` or a platform
# secret store / secret manager) and fill in real values. NEVER commit a real
# `.env` or any secret to Git. `.gitignore` ignores `.env*` while keeping
# `.env.example` itself.
#
# Production contract (see docs/PRODUCTION_DEPLOYMENT.md):
#   NODE_ENV=production requires S3-compatible storage, MongoDB, a Supabase
#   Auth project, an HTTPS origin in NEXARA_CORS_ORIGINS, and (when enforced)
#   an active malware scanner. Local book storage and test identities are
#   rejected by the runtime in production.
# ============================================================================

# --- Server ---------------------------------------------------------------
# HTTP listen port (integer 1..65535).
PORT=3000
# development | test | production. production enforces the hard gates below.
NODE_ENV=development

# --- Authentication provider ------------------------------------------------
# supabase (default; required in production) | local (development only).
# AUTH_PROVIDER=local enables password registration/login against MongoDB for
# local development; NODE_ENV=production rejects it and the server will not
# start. Keep VITE_AUTH_PROVIDER in sync — the client build uses it to select
# the matching provider adapter.
AUTH_PROVIDER=supabase
VITE_AUTH_PROVIDER=
# Development-only bootstrap admin (AUTH_PROVIDER=local only). Both values must
# be provided together; the password needs 10+ characters. There is no default
# admin identity: without this pair every local registration starts as READER.
NEXARA_LOCAL_ADMIN_EMAIL=
NEXARA_LOCAL_ADMIN_PASSWORD=
# Local session lifetime in hours (1..720, default 168 = 7 days).
NEXARA_LOCAL_SESSION_TTL_HOURS=168

# --- MongoDB (permanent store) ---------------------------------------------
# Either MONGODB_URI/MONGODB_DB_NAME or their MONGO_* aliases. Required in
# production; the server fails closed at startup if absent.
MONGODB_URI=
MONGO_URI=
MONGODB_DB_NAME=nexara
MONGO_DB_NAME=

# --- Supabase Auth ----------------------------------------------------------
# The client reads the VITE_* pair at build time; the server prefers the
# paired VITE_* values and falls back to the SUPABASE_* aliases so both layers
# always target the same project. Use a publishable/anon key, never the
# server-only admin/secret key (it must stay out of the deployment, client, or
# any build-time variable).
SUPABASE_URL=
VITE_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon-key aliases (preferred form is SUPABASE_PUBLISHABLE_KEY / VITE_*).
SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=

# --- CORS / proxy / startup ------------------------------------------------
# Comma-separated exact HTTPS origins (no path/query/fragment). Required in
# production. Only loopback http is tolerated when NEXARA_ALLOW_INSECURE_LOOPBACK=true.
NEXARA_CORS_ORIGINS=
NEXARA_ALLOW_INSECURE_LOOPBACK=false
# Number of trusted reverse proxies in front of Express (production default 1).
NEXARA_TRUST_PROXY_HOPS=0
# When true, the server refuses to listen until required dependencies are ready.
NEXARA_STARTUP_READINESS_REQUIRED=false
# Controlled deployment job only. Keep false in Vercel (concurrent cold-start
# migrations are unsafe); run `npm run db:migrate` as the controlled step.
NEXARA_APPLY_MIGRATIONS_ON_STARTUP=false

# --- MongoDB DNS workaround (local dev only) --------------------------------
# server.ts applies public IPv4 resolver servers + ipv4first ONLY when this is
# not false AND NODE_ENV != production. Leave false for production/normal dev.
NEXARA_ENABLE_DNS_FIX=false

# --- Book storage (S3-compatible object storage) ----------------------------
# Production requires BOOK_STORAGE_PROVIDER=s3 with all fields below.
# `local` (default) is dev-only and cannot mint signed write URLs, so the
# browser direct-upload panel cannot complete on it — use the ingestion path.
BOOK_STORAGE_PROVIDER=local
BOOK_STORAGE_BUCKET=
BOOK_STORAGE_ENDPOINT=
BOOK_STORAGE_REGION=auto
BOOK_STORAGE_ACCESS_KEY=
BOOK_STORAGE_SECRET_KEY=
BOOK_STORAGE_LOCAL_ROOT=.data/book-files
# Max accepted upload in bytes (1..104857600). Keep the edge proxy limit <= this.
BOOK_STORAGE_MAX_BYTES=104857600
# Signed write-URL TTL seconds (1..3600).
BOOK_STORAGE_SIGNED_URL_TTL_SECONDS=300

# --- Malware scanner (optional) ---------------------------------------------
# clamdscan (co-located daemon) | remote-http (standalone scanner service) | empty.
BOOK_MALWARE_SCANNER=
# When true, BOOK_MALWARE_SCANNER must be set and every file must pass a scan.
BOOK_REQUIRE_MALWARE_SCAN=false
# remote-http scanner origin (HTTPS required when NODE_ENV=production).
BOOK_MALWARE_SCANNER_URL=
# Server-only bearer token for remote-http. Never expose via a client variable.
BOOK_MALWARE_SCANNER_TOKEN=

# --- Post-deploy smoke test (not read by the runtime) ------------------------
# Origin (HTTPS, no path/query/fragment) the production:smoke gate probes.
NEXARA_DEPLOY_URL=